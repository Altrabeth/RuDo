"│     ╭ Help ────────────────────────────────────────────────────────────────────────────────────────────────────╮     │"
"│     │  ctrl-u, pageup    half a page up                                                                        │     │"
"│     │Trees (lists pane and tasks pane)                                                                         │     │"
"│     │  h, left           fold, else go to the parent; from a top-level task go to the lists pane               │     │"
"│     │  l, right          unfold, else open the selected list                                                   │     │"
"│     │  za                fold or unfold the selected entry                                                     │     │"
"│     │  zM                fold everything                                                                       │     │"
"│     │  zR                unfold everything                                                                     │     │"
"│     │  dd                delete the selected list, empty folder or task                                        │     │"
"│     │Lists pane                                                                                                │     │"
"│     │  enter             open the selected list, or fold or unfold a folder                                    │     │"
"│     │  o                 create a list next to the selection or inside the folder                              │     │"
"│     │  O                 create a folder                                                                       │     │"
"│     │  r                 rename the selected list or folder                                                    │     │"
"│     │Tasks pane                                                                                                │     │"
"│     │  o                 add a task below the selected one                                                     █     │"
"│     │  O                 add a task above the selected one                                                     █     │"
"│     │  a                 add a subtask to the selected task                                                    █     │"
"│     │  i, enter          edit the task text                                                                    █     │"
"│     │  x, space          mark as done or open again                                                            █     │"
"│     │  yy                copy the task and its subtasks                                                        █     │"
"│     │  p                 paste below the selected task                                                         █     │"
"│     │  P                 paste above the selected task                                                         █     │"
"│     │  J                 swap with the next sibling                                                            █     │"
"│     │  K                 swap with the previous sibling                                                        █     │"
"│     │  >                 make it a subtask of the task above                                                   █     │"
"│     │  <                 move it one level up                                                                  █     │"
"│     │  +                 raise the priority                                                                    █     │"
"│     │  -                 lower the priority                                                                    █     │"
"│     │  D                 set or clear the due date                                                             █     │"
"│     │  r                 set or clear the recurrence                                                           █     │"
"│     │  sp                sort the selected task and its siblings                                               █     │"
"│     │  sd                sort by due date, tasks without one last                                              █     │"
"│     │  sa                sort by text                                                                          █     │"
"│     │  ss                open tasks first                                                                      █     │"
"│     │Help screen, dialogs and text input                                                                       █     │"
"│     │  ?, q, esc         close the help screen                                                                 █     │"
"│     │  y, enter          confirm                                                                               █     │"
"│     │  n, esc            cancel                                                                                █     │"
"│     │  enter             accept the text                                                                       █     │"
"│     │  esc, ctrl-c       discard the text                                                                      █     │"
"│     │Editing keys in text input                                                                                █     │"
"│     │  left              move left                                                                             █     │"
"│     │  right             move right                                                                            █     │"
"│     │  ctrl-left         move to the previous word                                                             █     │"
"│     │  ctrl-right        move to the next word                                                                 █     │"
"│     │  home, ctrl-a      move to the start                                                                     █     │"
"│     │  end, ctrl-e       move to the end                                                                       █     │"
