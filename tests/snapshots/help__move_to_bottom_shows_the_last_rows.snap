"╭ Lists ───────────────╮╭ Tasks ───────────────────────────────────────────────╮"
"│ No╭ Help ────────────────────────────────────────────────────────────────╮   │"
"│ o │  due:<=fri             due before or after that day (<, <=, >, >=)   │   │"
"│   │  due:overdue           open and due before today                     │   │"
"│   │  due:none, due:any     without or with a due date                    │   │"
"│   │  created:>-1m          created in the last month (dates as for due)  │   │"
"│   │  done:<=-1w            completed a week ago or earlier               │   │"
"│   │  priority:>=medium     priority (lowest, low, medium, high, highest) │   │"
"│   │  #tag                  with the tag or a tag nested in it            │   │"
"│   │  is:open, is:done      open, or done or cancelled                    │   │"
"│   │Editing keys in text input                                            │   │"
"│   │  left                  move left                                     │   │"
"│   │  right                 move right                                    │   │"
"│   │  ctrl-left             move to the previous word                     │   │"
"│   │  ctrl-right            move to the next word                         │   │"
"│   │  home, ctrl-a          move to the start                             │   │"
"│   │  end, ctrl-e           move to the end                               │   │"
"│   │  backspace             delete the character before the cursor        │   │"
"│   │  delete                delete the character under the cursor         █   │"
"│   │  ctrl-w                delete the word before the cursor             █   │"
"│   │  ctrl-u                delete to the start                           █   │"
"│   │  ctrl-k                delete to the end (not in pickers)            █   │"
"╰───╰──────────────────────────────────────────────────────────── 80-99/99 ╯───╯"
